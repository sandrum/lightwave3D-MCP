# LightwaveMCP settings. Copy this file to `.env` (same folder) and edit.
# `.env` is git-ignored, so your values stay local. Every setting is
# optional - anything left out uses the default shown here. A real
# environment variable of the same name overrides the file.
#
# Both sides read these: server.py (Claude's side) and the scripts you
# load into LightWave. After changing a value, restart Claude Desktop AND
# reload the LightWave scripts (or restart Layout/Modeler).

# Machine LightWave runs on, as seen from server.py.
LW_MCP_HOST=localhost

# Layout's Command Port. Layout's title bar shows it as "(CP: 9735)" once
# lw_enable_command_port.py has run.
LW_MCP_LAYOUT_PORT=9735

# Modeler's Command Port - must differ from Layout's.
LW_MCP_MODELER_PORT=9736

# Folder where server.py and the LightWave scripts exchange reply, status
# and debug files. Empty means the folder these files live in. Created if
# it doesn't exist; ~ and %VARIABLES% are expanded.
LW_MCP_EXCHANGE_DIR=
